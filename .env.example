# Copien este archivo a .env (que no se sube) y ajusten lo que haga falta.
# cp .env.example .env

# --- Base de datos (bd) ---
DB_NAME=perritos_db
DB_USER=perritos
DB_PASSWORD=cambiar
DB_ROOT_PASSWORD=cambiar_root

# --- Backend (lee las mismas credenciales de arriba) ---
# DB_HOST y DB_PORT los fija docker-compose.yml (hablan entre contenedores,
# no hace falta tocarlos aquí).

# --- Zona horaria (para que "hoy"/"ayer" del servicio Elixir sean los de Saltillo) ---
TZ=America/Monterrey

# --- Túnel de Cloudflare (opcional) ---
# Déjenlo vacío para usar el quick tunnel (URL temporal, cambia en cada reinicio).
# Si algún integrante tiene cuenta y dominio propio, pongan aquí su token y
# cambien el "command" del servicio tunel en docker-compose.yml a:
#   command: tunnel --no-autoupdate run --token ${TUNNEL_TOKEN}
TUNNEL_TOKEN=
